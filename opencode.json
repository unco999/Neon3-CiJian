{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "limit": {
            "context": 100000,
            "output": 16000
          }
        }
      }
    },
    "yunquzhilian": {
      "models": {
        "gpt-5.6-terra": {
          "limit": {
            "context": 100000,
            "output": 16000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8,
    "preserve_recent_tokens": 80000,
    "reserved": 12000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 12000
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "D:\\goal\\**": "allow"
    }
  }
}
