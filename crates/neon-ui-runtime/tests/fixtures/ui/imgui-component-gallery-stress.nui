# 宫崎骏风格海滨小镇 · 汤屋商店街。所有控件仍绑定类型化 input + 语义 intent；
# 视觉主题从暗色工作台升级为温暖治愈的和风小镇，无 renderer 身份或领域规则。
version 1
surface surface.component-gallery revision 1
flow component-gallery
budget nodes=900 bindings=600 instances=600 text=900 glyphs=65536 events=300 clips=300
input controls_enabled bool default true
input feature_enabled bool default true emitevent
input radio_selected bool default false
input slider_value f32:0..1 default 0.5
input drag_value i32:0..24 default 12
input combo_choice enum:alpha|beta|gamma default beta
input dropdown_choice enum:alpha|beta|gamma default beta
input tabs_choice enum:alpha|beta|gamma default beta
input list_choice enum:alpha|beta|gamma default beta
input item_selected bool default true
input scroll_position f32:0..1 default 0.35
input dialog_visible bool default false
input gallery_text text default text:empty
input progress_value f32:0..1 default 0.68
input asset_window grid default grid:empty
resource gallery-image image
resource world-ui-lab.preview render_surface
machine town_tabs initial beta
state town_tabs alpha
state town_tabs gamma
sync town_tabs when $tabs_choice=alpha -> alpha
sync town_tabs when $tabs_choice=beta -> beta
sync town_tabs when $tabs_choice=gamma -> gamma
drag compass-drag source backpack-compass axis both snap 0 threshold 3 within surface
drag potion-drag source backpack-potion axis both snap 0 threshold 3 within surface
drag gem-drag source backpack-gem axis both snap 0 threshold 3 within surface
drop equipment-compass-drop target equipment-zone accepts compass-drag placement into present equipment-item-template emit inventory.item.equip
drop crafting-potion-drop target crafting-zone accepts potion-drag placement into present crafting-item-template emit inventory.item.craft
drop discard-gem-drop target discard-zone accepts gem-drag placement into present discarded-item-template emit inventory.item.discard
surface component-gallery overlay minw 2048 h 1080 align stretch clip scroll fill #A8D8E8
  panel gallery-layout row minw 2048 gap 12 pad 16 align stretch fill #A8D8E8
    scroll gallery-controls column minw 360 maxw 430 grow 1 shrink 0 gap 6 pad 10 align stretch fill #F6EBD8 line #C89B6B
      panel sky-banner row h 64 pad 10 gap 10 align center fill #A8D8E8 line #7FB5C9
        text sky-title value "宫崎小镇 · 汤屋商店街"
        text sky-subtitle value "海风 云影 与一盏暖灯"
      button action-button h 30 checked $feature_enabled enabled $controls_enabled value "点亮灯笼" event gallery.button.activate
      input gallery-text h 32 enabled $controls_enabled value $gallery_text event gallery.text.commit
      text status-gallery_text h 18 value "Text input: empty"
      progress_bar gallery-progress h 24 numeric $progress_value enabled $controls_enabled value "温泉水位"
      text status-progress_value h 18 value "progress_value: 0.68"
      panel image-preview column h 126 gap 6 pad 8 align stretch fill #FDF9F2 line #C89B6B
        text image-preview-title h 18 value "店铺招牌"
        image gallery-image h 88 resource gallery-image fill #F0E4CE line #B8845C
      checkbox feature-toggle h 30 checked $feature_enabled enabled $controls_enabled value "营业中" event gallery.checkbox.toggle
      text status-feature_enabled h 18 value "feature_enabled: true"
      radio_button mode-radio h 30 selected $radio_selected enabled $controls_enabled value "晴日" event gallery.radio.select
      text status-radio_selected h 18 value "radio_selected: false"
      slider exposure-slider h 30 numeric $slider_value enabled $controls_enabled value "天色" event gallery.slider.commit
      text status-slider_value h 18 value "slider_value: 0.5"
      drag_value count-drag h 30 numeric $drag_value enabled $controls_enabled value "柴火捆数" event gallery.drag_value.commit
      text status-drag_value h 18 value "Current count: 12"
      combo mode-combo h 32 state $combo_choice enabled $controls_enabled value "店铺类型" event gallery.combo.select
      text status-combo_choice h 18 value "combo_choice: beta"
      dropdown mode-dropdown h 32 state $dropdown_choice enabled $controls_enabled value "今日菜单" event gallery.dropdown.select
      text status-dropdown_choice h 18 value "dropdown_choice: beta"
      tabs mode-tabs h 32 state $tabs_choice enabled $controls_enabled value "游览区域" event gallery.tabs.select
      text status-tabs_choice h 18 value "Selected mode: beta"
      selectable item-selectable h 30 selected $item_selected enabled $controls_enabled value "招牌选择" event gallery.selectable.select
      text status-item_selected h 18 value "item_selected: true"
      list_box item-list h 90 state $list_choice enabled $controls_enabled value "货架清单" event gallery.list_box.select
      text status-list_choice h 18 value "Selected mode: beta"
      scrollbar gallery-scroll h 20 scroll $scroll_position enabled $controls_enabled value "卷轴" event gallery.scrollbar.commit
        tooltip gallery-scroll-tooltip x 0 y 26 w 184 h 34 fill #F2C94C value "卷轴：本地悬浮提示"
      text status-scroll_position h 18 value "scroll_position: 0.35"
      panel control-reference h 132 column pad 8 gap 6 fill #FDF9F2 line #C89B6B
        text control-reference-title value "小镇手记"
        text control-reference-body value "暖帘、风铃与柴火。控件状态、语义事件与本地展示都留在这条卷轴里。"
      checkbox dialog-toggle h 30 checked $dialog_visible enabled $controls_enabled value "打开告示" event gallery.dialog.toggle
    
    scroll imgui-perf-stress column minw 360 maxw 430 grow 1 shrink 0 gap 6 pad 10 align stretch fill #EAF6FA line #6FA8C9
      panel imgui-header row h 32 pad 6 gap 6 align center fill #6FA8C9 line #4E8FAE
        text imgui-title value "性能压力测试 (IMGUI UI)"
      panel imgui-row-1 row h 24 pad 4 gap 6 align center
        text imgui-label-1 w 120 h 16 value "IMGUI 仪表盘 #1"
        checkbox imgui-cb-1 w 60 h 20 checked $radio_selected enabled $controls_enabled value "开"
        slider imgui-slider-1 w 120 h 20 numeric $slider_value enabled $controls_enabled value "调节"
      panel imgui-row-2 row h 24 pad 4 gap 6 align center
