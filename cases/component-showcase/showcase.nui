# Neon3 Component Showcase - 综合组件展示案例
# 验证: skin系统(9种组件) + scrollable + 属性绑定 + 新组件(Splitter/ContextMenu/TreeView)

resource btn-idle image
resource btn-hover image
resource btn-idle-dark image
resource btn-hover-dark image
resource btn-idle-warm image
resource btn-hover-warm image
resource panel-bg image
resource panel-dark image
resource panel-warm image
resource panel-accent image
resource track-bg image
resource fill-bg image
resource thumb-bg image
resource check-icon image
resource radio-dot image
resource input-bg image
resource tooltip-bg image
resource scrollbar-track image
resource scrollbar-thumb image
resource progress-track image
resource progress-fill image
resource slider-fat-track image
resource slider-fat-fill image
resource slider-fat-thumb image
resource slider-min-track image
resource slider-min-fill image
resource slider-min-thumb image
resource check-dark-body image
resource check-dark-icon image
resource check-warm-body image
resource check-warm-icon image
resource progress-blue-fill image
resource progress-warm-fill image
resource input-dark-bg image
resource input-warm-bg image
resource check-circle-ring image
resource check-circle-dot image
resource check-card-body image
resource check-card-icon image
resource progress-striped-fill image
resource progress-rounded-track image
resource progress-rounded-fill image
resource slider-square-thumb image
resource slider-square-track image
resource slider-square-fill image
resource scrollbar-fat-track image
resource scrollbar-fat-thumb image
resource scrollbar-dark-track image
resource scrollbar-dark-thumb image
resource radio-circle-ring image
resource radio-circle-dot image
resource radio-card-body image
resource radio-card-icon image
resource tooltip-dark-bg image
resource tooltip-accent-bg image

# === Skin 定义 (9种组件 + 多套变体) ===
skin btn-style button
  slot body idle resource btn-idle nine_slice 4 4 4 4 border 6 6 6 6
  slot body hover resource btn-hover nine_slice 4 4 4 4 border 6 6 6 6

skin btn-dark button
  slot body idle resource btn-idle-dark nine_slice 4 4 4 4 border 6 6 6 6
  slot body hover resource btn-hover-dark nine_slice 4 4 4 4 border 6 6 6 6

skin btn-warm button
  slot body idle resource btn-idle-warm nine_slice 4 4 4 4 border 6 6 6 6
  slot body hover resource btn-hover-warm nine_slice 4 4 4 4 border 6 6 6 6

skin panel-style panel
  slot body idle resource panel-bg nine_slice 8 8 8 8 border 12 12 12 12

skin panel-dark panel
  slot body idle resource panel-dark nine_slice 8 8 8 8 border 12 12 12 12

skin panel-warm panel
  slot body idle resource panel-warm nine_slice 8 8 8 8 border 12 12 12 12

skin panel-accent panel
  slot body idle resource panel-accent nine_slice 8 8 8 8 border 12 12 12 12

skin slider-style slider
  slot track idle resource track-bg nine_slice 2 2 2 2 border 3 3 3 3
  slot fill active resource fill-bg
  slot thumb idle resource thumb-bg fit contain

skin scrollbar-style scrollbar
  slot track idle resource scrollbar-track
  slot thumb idle resource scrollbar-thumb fit contain

skin progress-style progress_bar
  slot track idle resource progress-track
  slot fill active resource progress-fill

skin checkbox-style checkbox
  slot body idle resource input-bg nine_slice 3 3 3 3 border 4 4 4 4
  slot body hover resource input-bg nine_slice 3 3 3 3 border 4 4 4 4
  slot fill active resource check-icon fit contain

skin radio-style radio_button
  slot body idle resource input-bg nine_slice 3 3 3 3 border 4 4 4 4
  slot body hover resource input-bg nine_slice 3 3 3 3 border 4 4 4 4
  slot fill active resource radio-dot fit contain

skin input-style input
  slot body idle resource input-bg nine_slice 3 3 3 3 border 4 4 4 4
  slot body hover resource input-bg nine_slice 3 3 3 3 border 4 4 4 4
  slot body active resource input-bg nine_slice 3 3 3 3 border 4 4 4 4

skin tooltip-style tooltip
  slot body idle resource tooltip-bg nine_slice 6 6 6 6 border 8 8 8 8

# === Slider 变体 ===
skin slider-fat slider
  slot track idle resource slider-fat-track nine_slice 4 4 4 4 border 8 8 8 8
  slot fill active resource slider-fat-fill
  slot thumb idle resource slider-fat-thumb fit contain

skin slider-minimal slider
  slot track idle resource slider-min-track nine_slice 1 1 1 1 border 1 1 1 1
  slot fill active resource slider-min-fill
  slot thumb idle resource slider-min-thumb fit contain

# === Checkbox 变体 ===
skin checkbox-dark checkbox
  slot body idle resource check-dark-body nine_slice 3 3 3 3 border 5 5 5 5
  slot body hover resource check-dark-body nine_slice 3 3 3 3 border 5 5 5 5
  slot fill active resource check-dark-icon fit contain

skin checkbox-warm checkbox
  slot body idle resource check-warm-body nine_slice 3 3 3 3 border 5 5 5 5
  slot body hover resource check-warm-body nine_slice 3 3 3 3 border 5 5 5 5
  slot fill active resource check-warm-icon fit contain

# === ProgressBar 变体 ===
skin progress-blue progress_bar
  slot track idle resource progress-track
  slot fill active resource progress-blue-fill

skin progress-warm progress_bar
  slot track idle resource progress-track
  slot fill active resource progress-warm-fill

# === Input 变体 ===
skin input-dark input
  slot body idle resource input-dark-bg nine_slice 3 3 3 3 border 5 5 5 5
  slot body hover resource input-dark-bg nine_slice 3 3 3 3 border 5 5 5 5
  slot body active resource input-dark-bg nine_slice 3 3 3 3 border 5 5 5 5

skin input-warm input
  slot body idle resource input-warm-bg nine_slice 3 3 3 3 border 5 5 5 5
  slot body hover resource input-warm-bg nine_slice 3 3 3 3 border 5 5 5 5
  slot body active resource input-warm-bg nine_slice 3 3 3 3 border 5 5 5 5

# === Checkbox 圆形样式 ===
skin checkbox-circle checkbox
  slot body idle resource check-circle-ring fit contain
  slot body hover resource check-circle-ring fit contain
  slot fill active resource check-circle-dot fit contain

# === Checkbox 卡片样式（粗边框紫色） ===
skin checkbox-card checkbox
  slot body idle resource check-card-body nine_slice 4 4 4 4 border 6 6 6 6
  slot body hover resource check-card-body nine_slice 4 4 4 4 border 6 6 6 6
  slot fill active resource check-card-icon fit contain

# === ProgressBar 条纹样式 ===
skin progress-striped progress_bar
  slot track idle resource progress-track
  slot fill active resource progress-striped-fill

# === ProgressBar 圆角样式 ===
skin progress-rounded progress_bar
  slot track idle resource progress-rounded-track fit contain
  slot fill active resource progress-rounded-fill fit contain

# === Slider 方块滑块样式 ===
skin slider-square slider
  slot track idle resource slider-square-track nine_slice 2 2 2 2 border 3 3 3 3
  slot fill active resource slider-square-fill
  slot thumb idle resource slider-square-thumb fit contain

# === Scrollbar 变体 ===
skin scrollbar-fat scrollbar
  slot track idle resource scrollbar-fat-track
  slot thumb idle resource scrollbar-fat-thumb fit contain

skin scrollbar-dark scrollbar
  slot track idle resource scrollbar-dark-track
  slot thumb idle resource scrollbar-dark-thumb fit contain

# === RadioButton 变体 ===
skin radio-circle radio_button
  slot body idle resource radio-circle-ring fit contain
  slot body hover resource radio-circle-ring fit contain
  slot fill active resource radio-circle-dot fit contain

skin radio-card radio_button
  slot body idle resource radio-card-body nine_slice 4 4 4 4 border 6 6 6 6
  slot body hover resource radio-card-body nine_slice 4 4 4 4 border 6 6 6 6
  slot fill active resource radio-card-icon fit contain

# === Tooltip 变体 ===
skin tooltip-dark tooltip
  slot body idle resource tooltip-dark-bg nine_slice 6 6 6 6 border 8 8 8 8

skin tooltip-accent tooltip
  slot body idle resource tooltip-accent-bg nine_slice 6 6 6 6 border 8 8 8 8

# === Input 变量 ===
input alpha f32 default 0.9
input offset vec2 default 0,0
input scroll_pos f32:0..1 default 0.3
input progress_val f32:0..1 default 0.65
input slider_val f32:0..100 default 42
input checkbox_state bool default true
input radio_state bool default false
input switch_state bool default true
input text_value text default text:empty
input dynamic_text text default text:empty

# === 主界面 ===
surface showcase overlay w 1200 h 1000 align stretch fill #0D1117

  # 空白点击捕获层（最底层，点击空白区域发送 ui.click_blank 事件）
  panel click-capture x 0 y 0 w 1200 h 1000 fill #00000000 event ui.click_blank

  # 左侧面板 - 带skin
  panel left-panel skin panel-style x 20 y 20 w 360 h 960 column pad 16 gap 12 align stretch

    text title h 32 value "Component Showcase"
    text subtitle h 24 value "9 skin types + scrollable + bindings"

    # Button with skin
    button btn-demo skin btn-style h 40 value "Skinned Button" event demo.button.click

    # Slider with skin
    slider slider-demo skin slider-style h 24 numeric $slider_val event demo.slider.commit

    # ProgressBar with skin
    progress_bar progress-demo skin progress-style h 16 numeric $progress_val

    # Scrollbar with skin (vertical)
    scrollbar scroll-demo skin scrollbar-style x 320 y 200 w 16 h 120 scroll $scroll_pos

    # Checkbox with skin
    checkbox check-demo skin checkbox-style h 24 checked $checkbox_state value "Skinned Checkbox" event demo.check.toggle

    # RadioButton with skin
    radio_button radio-demo skin radio-style h 24 checked $radio_state value "Skinned Radio" event demo.radio.toggle

    # TextInput with skin
    input text-demo skin input-style h 32 value $text_value event demo.text.commit

    # Opacity binding demo
    panel opacity-demo x 0 y 0 w 100 h 40 fill #58A6FF opacity $alpha
    text opacity-label h 24 value "Opacity binding demo"

    # === Skin 变体展示区 ===
    text skin-section-title h 28 value "Skin Variants"

    text skin-slider-label h 20 value "Slider:"
    panel skin-slider-row w 328 h 40 row gap 12 align center
      slider skin-slider-def skin slider-style w 100 h 22 numeric $slider_val
      slider skin-slider-fat skin slider-fat w 100 h 36 numeric $slider_val
      slider skin-slider-min skin slider-minimal w 100 h 14 numeric $slider_val

    text skin-check-label h 20 value "Checkbox:"
    panel skin-check-row w 328 h 40 row gap 12 align center
      checkbox skin-check-def skin checkbox-style w 100 h 24 value "Square" event demo.skin.check.def
      checkbox skin-check-circle skin checkbox-circle w 100 h 28 value "Circle" event demo.skin.check.circle
      checkbox skin-check-card skin checkbox-card w 100 h 32 value "Card" event demo.skin.check.card

    text skin-prog-label h 20 value "ProgressBar:"
    panel skin-prog-row w 328 h 24 row gap 12
      progress_bar skin-prog-def skin progress-style w 100 h 14 numeric $progress_val
      progress_bar skin-prog-striped skin progress-striped w 100 h 20 numeric $progress_val
      progress_bar skin-prog-rounded skin progress-rounded w 100 h 14 numeric $progress_val

    text skin-input-label h 20 value "Input:"
    panel skin-input-row w 328 h 36 row gap 12
      input skin-input-def skin input-style w 100 h 28 value "Default"
      input skin-input-dark skin input-dark w 100 h 32 value "Dark"
      input skin-input-warm skin input-warm w 100 h 28 value "Warm"

    text skin-scroll-label h 20 value "Scrollbar:"
    panel skin-scroll-row w 328 h 64 column gap 6
      scrollbar skin-scroll-def skin scrollbar-style w 300 h 14 scroll $scroll_pos
      scrollbar skin-scroll-fat skin scrollbar-fat w 300 h 20 scroll $scroll_pos
      scrollbar skin-scroll-dark skin scrollbar-dark w 300 h 10 scroll $scroll_pos

    text skin-radio-label h 20 value "RadioButton:"
    panel skin-radio-row w 328 h 36 row gap 12 align center
      radio_button skin-radio-def skin radio-style w 100 h 24 value "Default" event demo.skin.radio.def
      radio_button skin-radio-circle skin radio-circle w 100 h 28 value "Circle" event demo.skin.radio.circle
      radio_button skin-radio-card skin radio-card w 100 h 32 value "Card" event demo.skin.radio.card

  # 中间面板 - Scrollable 容器
  panel mid-panel skin panel-style x 400 y 20 w 380 h 960 column pad 16 gap 8 align stretch

    text mid-title h 28 value "Scrollable Container"
    text mid-sub h 24 value "scrollable + scroll_offset binding"

    # Scrollable panel with scroll_offset binding
    panel scroller x 0 y 80 w 340 h 400 scrollable scroll_offset $offset column pad 12 gap 8 align stretch

      text item-1 h 32 value "Item 1 - This is a long text that should wrap" fill #161B22
      text item-2 h 32 value "Item 2" fill #161B22
      text item-3 h 32 value "Item 3" fill #161B22
      text item-4 h 32 value "Item 4" fill #161B22
      text item-5 h 32 value "Item 5" fill #161B22
      text item-6 h 32 value "Item 6" fill #161B22
      text item-7 h 32 value "Item 7" fill #161B22
      text item-8 h 32 value "Item 8" fill #161B22
      text item-9 h 32 value "Item 9" fill #161B22
      text item-10 h 32 value "Item 10 - Last item" fill #161B22

    # Scroll control buttons
    button scroll-up h 28 value "Scroll Up" event demo.scroll.up
    button scroll-down h 28 value "Scroll Down" event demo.scroll.down

  # 右侧面板 - 新组件展示
  panel right-panel skin panel-style x 800 y 20 w 380 h 960 column pad 16 gap 12 align stretch context_menu demo-context

    text right-title h 28 value "New Components"
    text right-sub h 24 value "Splitter / ContextMenu / TreeView"

    # Splitter demo (horizontal layout with splitter)
    text split-label h 24 value "Splitter (drag to resize)"
    panel split-container w 344 h 120
      panel split-left x 0 y 0 w 140 h 120 fill #1F6FEB33
        text split-left-label x 4 y 4 w 132 h 24 value "Left Pane"
      splitter split-h x 140 y 0 w 8 h 120 event demo.splitter.toggle
      panel split-right x 148 y 0 w 196 h 120 fill #1F6FEB22
        text split-right-label x 4 y 4 w 184 h 24 value "Right Pane"

    # ContextMenu (right-click to show, uses context_menu component)
    text ctx-label h 24 value "ContextMenu (right-click anywhere)"
    context_menu demo-context x 16 y 200 w 180 h 120
      text ctx-item-1 x 8 y 8 w 164 h 28 value "Copy" event demo.ctx.copy
      text ctx-item-2 x 8 y 40 w 164 h 28 value "Paste" event demo.ctx.paste
      text ctx-item-3 x 8 y 72 w 164 h 28 value "Delete" event demo.ctx.delete
    button show-ctx-btn h 28 value "Show Context Menu" event demo.ctx.show

    # TreeView (hierarchical, uses tree_view component)
    text tree-label h 24 value "TreeView (hierarchical structure)"
    tree_view demo-tree w 340 h 200
      text tree-root x 8 y 20 w 324 h 24 value "▼ project/" event demo.tree.root
      text tree-crate-1 x 24 y 36 w 308 h 24 value "▼ crates/" event demo.tree.crates
      text tree-crate-2 x 40 y 64 w 292 h 24 value "neon-ui-schema" event demo.tree.schema
      text tree-crate-3 x 40 y 92 w 292 h 24 value "neon-ui-runtime" event demo.tree.runtime
      text tree-crate-4 x 40 y 120 w 292 h 24 value "neon-wgpu-runtime" event demo.tree.wgpu
      text tree-docs x 24 y 148 w 308 h 24 value "▶ docs/" event demo.tree.docs
      text tree-cases x 24 y 176 w 308 h 24 value "▶ cases/" event demo.tree.cases

    # === 新增组件测试区 ===
    divider new-comp-divider w 344 h 2

    # Switch - 开关组件
    text switch-label h 24 value "Switch (toggle)"
    switch switch-demo w 344 h 32 checked $switch_state value "Enable feature" event demo.switch.toggle

    # MenuBar - 菜单栏（点击展开下拉）
    text menubar-label h 24 value "MenuBar (click to expand)"
    menu_bar demo-menubar w 344 h 32
      text mb-file x 8 y 4 w 60 h 24 value "File" event demo.mb.file
      text mb-edit x 76 y 4 w 60 h 24 value "Edit" event demo.mb.edit
      text mb-view x 144 y 4 w 60 h 24 value "View" event demo.mb.view
      text mb-help x 212 y 4 w 60 h 24 value "Help" event demo.mb.help
      # MenuBar 下拉（Popup 顶层容器，作为 MenuBar 子节点，绝对定位紧跟下方）
      popup mb-dropdown x 0 y 32 w 160 h 88 visible false
        text mb-dd-1 x 8 y 4 w 144 h 20 value "New" event demo.mb.dd1
        text mb-dd-2 x 8 y 26 w 144 h 20 value "Open..." event demo.mb.dd2
        text mb-dd-3 x 8 y 48 w 144 h 20 value "Save" event demo.mb.dd3
        text mb-dd-4 x 8 y 70 w 144 h 20 value "Quit" event demo.mb.dd4

    # Accordion - 折叠面板
    text accordion-label h 24 value "Accordion (click header to expand)"
    accordion demo-accordion w 344 h 280
      panel acc-general-header x 0 y 0 w 344 h 36 fill #161B22
        text acc-h1 x 8 y 6 w 328 h 24 value "▼ General Settings" event demo.acc.general
      panel acc-general-content x 0 y 36 w 344 h 60 fill #0D1117
        text acc-general-text x 12 y 8 w 320 h 20 value "Theme: Dark"
        text acc-general-text2 x 12 y 32 w 320 h 20 value "Language: English"
      panel acc-advanced-header x 0 y 96 w 344 h 36 fill #161B22
        text acc-h2 x 8 y 6 w 328 h 24 value "▶ Advanced Options" event demo.acc.advanced
      panel acc-advanced-content x 0 y 132 w 344 h 60 fill #0D1117
        text acc-adv-text x 12 y 8 w 320 h 20 value "GPU Acceleration: On"
        text acc-adv-text2 x 12 y 32 w 320 h 20 value "VSync: Enabled"
      panel acc-about-header x 0 y 192 w 344 h 36 fill #161B22
        text acc-h3 x 8 y 6 w 328 h 24 value "▶ About" event demo.acc.about
      panel acc-about-content x 0 y 228 w 344 h 48 fill #0D1117
        text acc-about-text x 12 y 8 w 320 h 20 value "Neon3 UI Framework"
        text acc-about-text2 x 12 y 30 w 320 h 20 value "Version 0.2.8"

    # Spinner - 加载指示器
    text spinner-label h 24 value "Spinner (loading)"
    panel spinner-row w 344 h 40 row gap 16 align center
      spinner spinner-sm w 24 h 24
      spinner spinner-md w 32 h 32
      spinner spinner-lg w 40 h 40

    # Skin Variants — 同组件多套 skin 静态展示
    text skin-label h 24 value "Skin Variants (same component, different skins)"
    panel skin-row w 344 h 80 row gap 8
      panel skin-panel-default skin panel-style w 80 h 80
        text skin-t1 x 4 y 8 w 72 h 24 value "Default"
      panel skin-panel-dark skin panel-dark w 80 h 80
        text skin-t2 x 4 y 8 w 72 h 24 value "Dark"
      panel skin-panel-warm skin panel-warm w 80 h 80
        text skin-t3 x 4 y 8 w 72 h 24 value "Warm"
      panel skin-panel-accent skin panel-accent w 80 h 80
        text skin-t4 x 4 y 8 w 72 h 24 value "Accent"
    panel skin-btn-row w 344 h 36 row gap 10
      button skin-btn-default skin btn-style w 108 h 36 value "Default"
      button skin-btn-dark skin btn-dark w 108 h 36 value "Dark"
      button skin-btn-warm skin btn-warm w 108 h 36 value "Warm"

  # Tooltip variants (top layer, static display)
  tooltip skin-tooltip-def skin tooltip-style x 420 y 940 w 120 h 40
    text tt-def-text h 20 value "Default Tip"
  tooltip skin-tooltip-dark skin tooltip-dark x 560 y 940 w 120 h 40
    text tt-dark-text h 20 value "Dark Tip"
  tooltip skin-tooltip-accent skin tooltip-accent x 700 y 940 w 120 h 40
    text tt-accent-text h 20 value "Accent Tip"

  # Toast - 顶层通知
  toast demo-toast x 820 y 940 w 200 h 48
    text toast-text x 12 y 12 w 176 h 24 value "Saved successfully!"

  # Dynamic text binding demo
  text dynamic-label x 20 y 980 w 300 h 20 value $dynamic_text
